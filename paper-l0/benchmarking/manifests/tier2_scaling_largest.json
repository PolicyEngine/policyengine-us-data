{
  "description": "Tier 2 largest coherent pre-production scaling rung. All states, all districts, all geo levels, no max_targets cap. This is one rung short of the production manifest only because Tier 3 reuses the exact same filter \u2014 the difference is in reporting (Tier 2 marks failures alongside successes; Tier 3 reports completion / failure status only).",
  "external_inputs": {},
  "method_options": {
    "greg": {
      "epsilon": 1e-07,
      "maxit": 200
    },
    "ipf": {
      "bound": 10.0,
      "count_variable": "household_count",
      "epsH": 0.01,
      "epsP": 0.0001,
      "household_id_col": "household_id",
      "max_iter": 5000,
      "return_na": true,
      "weight_col": "base_weight"
    },
    "l0": {
      "beta": 0.65,
      "device": "cpu",
      "epochs": 5000,
      "lambda_l0": 1e-08,
      "lambda_l2": 1e-12,
      "learning_rate": 0.15,
      "seed": 42
    }
  },
  "methods": [
    "l0",
    "greg",
    "ipf"
  ],
  "name": "tier2_scaling_largest",
  "package_path": "policyengine_us_data/storage/calibration/calibration_package.pkl",
  "target_filters": {
    "count_like_only": false,
    "include_geo_levels": [
      "national",
      "state",
      "district"
    ],
    "include_national": true
  },
  "tier": "tier_2"
}